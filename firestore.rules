rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function staff() { return request.auth != null && request.auth.token.email in ['equipe@loucos-por-pastel.app', 'admin@loucos-por-pastel.app']; }
    function admin() { return request.auth != null && request.auth.token.email == 'admin@loucos-por-pastel.app'; }
    match /pedidos/{id} { allow read, write: if staff(); }
    match /pagamentos/{id} { allow read, write: if staff(); }
    match /mesas/{id} {
      allow get: if id in ['_cardapio', '_horario'] || staff();
      allow list: if staff();
      allow write: if admin() || (staff() && !id.matches('_.*'));
    }
    match /fechamentos/{id} {
      allow create: if staff();
      allow read, update, delete: if admin();
    }
    match /clientes/{tel} {
      allow get: if true;
      allow list, delete: if staff();
      allow create, update: if tel.matches('[0-9]{10,11}') && request.resource.data.tel == tel
        && request.resource.data.keys().hasOnly(['nome', 'tel', 'end', 'em', 'pedidos']);
    }
    match /online/{id} {
      allow get: if true;
      allow list, update, delete: if staff();
      allow create: if request.resource.data.st == 'novo' && request.resource.data.canal == 'online'
        && request.resource.data.keys().hasOnly(['st', 'canal', 'cli', 'tipo', 'end', 'hora', 'itens', 'sub', 'taxa', 'total', 'pag', 'obs', 'em']);
    }
  }
}
