rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function logado() { return request.auth != null; }
    function admin() { return logado() && request.auth.token.email == 'admin@loucos-por-pastel.app'; }
    match /pedidos/{id} { allow read, write: if logado(); }
    match /pagamentos/{id} { allow read, write: if logado(); }
    match /mesas/{id} {
      allow read: if logado();
      allow write: if admin() || (logado() && !id.matches('_.*'));
    }
    match /fechamentos/{id} {
      allow create: if logado();
      allow read, update, delete: if admin();
    }
  }
}
